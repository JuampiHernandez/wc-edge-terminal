# Copy to .env.local and fill in your keys.
#
# football-data.org — register at https://www.football-data.org/client/register
#   Header: X-Auth-Token
FOOTBALL_DATA_API_KEY=

# API-Football — register at https://dashboard.api-football.com/register
#   Header: x-apisports-key
#   Free plan: seasons 2022–2024 only (WC 2026 injuries need paid tier)
API_FOOTBALL_KEY=

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Daily digest emails (optional) — https://resend.com
RESEND_API_KEY=
DIGEST_FROM_EMAIL=digest@yourdomain.com
CRON_SECRET=
