# Copy to .env.local and fill in your keys.
#
# football-data.org — register at https://www.football-data.org/client/register
#   Header: X-Auth-Token
FOOTBALL_DATA_API_KEY=

# API-Football — register at https://dashboard.api-football.com/register
#   Header: x-apisports-key
#   Free plan: seasons 2022–2024 only (WC 2026 injuries need paid tier)
API_FOOTBALL_KEY=

# News APIs (optional — cached 1h to protect daily quotas)
# NewsAPI — https://newsapi.org/register (free: 100 req/day, dev-only on free tier)
NEWS_API_KEY=
# GNews — https://gnews.io/register (free: 100 req/day)
GNEWS_API_KEY=
# Currents — https://currentsapi.services/en/register (free: 600 req/day)
CURRENTS_API_KEY=
# Alias supported if you named it differently:
# CURRENT_API_KEY=

# GDELT DOC 2.0 — no key needed. Used automatically.
# Docs: https://blog.gdeltproject.org/gdelt-doc-2-0-api-debuts/

# LLM news digestion (npm run research:enrich). Terminal never calls the model on page load.
# Prefer Vercel AI Gateway; OpenAI-compatible fallback supported.
AI_GATEWAY_API_KEY=
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
# AI_NEWS_MODEL=openai/gpt-4o-mini
# AI_NEWS_ENRICH_LIMIT=1200
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Reddit — https://www.reddit.com/prefs/apps (create "web app" or "script")
# After creating the app: client ID = string under app name, secret = "secret" field
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Required format: platform:appid:version (by /u/yourusername)
REDDIT_USER_AGENT=web:worldcupterminal:v1.0 (by /u/yourredditusername)

# Supabase — https://supabase.com/dashboard/project/kyuiszbcculbazcuedjl/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://kyuiszbcculbazcuedjl.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service role key — server/cron only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth — Supabase Dashboard → Authentication → Providers → Google
# Google Cloud redirect URI:
#   https://kyuiszbcculbazcuedjl.supabase.co/auth/v1/callback
# Supabase Auth → URL Configuration:
#   Site URL: https://worldcupterminal.xyz
#   Redirect URLs (add both):
#     https://worldcupterminal.xyz/auth/callback
#     http://localhost:3000/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Daily deep news research (team + player keywords, 24h window → Supabase):
#   npm run research:news          # run locally every 24h
#   npm run cron:news-research     # hit /api/cron/news-research on a running server

# Local dev: when Polymarket Gamma is blocked on your network, markets load from prod.
# TERMINAL_EVENTS_FALLBACK_URL=https://worldcupterminal.xyz/api/terminal

# Daily cron (Vercel Hobby = once/day) — generate with: openssl rand -base64 32
# Add same value in Vercel project env vars. Vercel sends it on cron invocations.
CRON_SECRET=

# Daily digest emails (optional) — https://resend.com
RESEND_API_KEY=
DIGEST_FROM_EMAIL=digest@yourdomain.com
