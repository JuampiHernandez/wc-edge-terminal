# Copy to .env.local and fill in your keys.
#
# football-data.org — register at https://www.football-data.org/client/register
#   Header: X-Auth-Token
FOOTBALL_DATA_API_KEY=

# API-Football — register at https://dashboard.api-football.com/register
#   Header: x-apisports-key
#   Free plan: seasons 2022–2024 only (WC 2026 injuries need paid tier)
API_FOOTBALL_KEY=

# News APIs (optional — cached 1h to protect daily quotas)
# NewsAPI — https://newsapi.org/register (free: 100 req/day, dev-only on free tier)
NEWS_API_KEY=
# GNews — https://gnews.io/register (free: 100 req/day)
GNEWS_API_KEY=
# Currents — https://currentsapi.services/en/register (free: 600 req/day)
CURRENTS_API_KEY=
# Alias supported if you named it differently:
# CURRENT_API_KEY=

# GDELT DOC 2.0 — no key needed. Used automatically.
# Docs: https://blog.gdeltproject.org/gdelt-doc-2-0-api-debuts/

# Reddit — https://www.reddit.com/prefs/apps (create "web app" or "script")
# After creating the app: client ID = string under app name, secret = "secret" field
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Required format: platform:appid:version (by /u/yourusername)
REDDIT_USER_AGENT=web:worldcupterminal:v1.0 (by /u/yourredditusername)

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Daily cron (Vercel Hobby = once/day) — generate with: openssl rand -base64 32
# Add same value in Vercel project env vars. Vercel sends it on cron invocations.
CRON_SECRET=

# Daily digest emails (optional) — https://resend.com
RESEND_API_KEY=
DIGEST_FROM_EMAIL=digest@yourdomain.com
