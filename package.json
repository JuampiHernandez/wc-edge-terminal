{
  "name": "wc-edge-terminal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "cron:daily": "curl -sf -H \"Authorization: Bearer ${CRON_SECRET}\" \"${CRON_URL:-http://localhost:3000}/api/cron/digest\"",
    "cron:rosters": "curl -sf -H \"Authorization: Bearer ${CRON_SECRET}\" \"${CRON_URL:-http://localhost:3000}/api/cron/digest?teams=48\"",
    "cron:news-research": "curl -sf -H \"Authorization: Bearer ${CRON_SECRET}\" \"${CRON_URL:-http://localhost:3000}/api/cron/news-research\"",
    "cron:news-enrich": "curl -sf -H \"Authorization: Bearer ${CRON_SECRET}\" \"${CRON_URL:-http://localhost:3000}/api/cron/news-enrich\"",
    "research:news": "tsx --env-file=.env.local scripts/deep-news-research.ts",
    "research:enrich": "tsx --env-file=.env.local scripts/enrich-news.ts",
    "research:enrich:force": "FORCE=1 tsx --env-file=.env.local scripts/enrich-news.ts",
    "research:full": "tsx --env-file=.env.local scripts/research-full.ts",
    "research:reclassify": "tsx --env-file=.env.local scripts/reclassify-news.ts",
    "research:esp": "NATIONS=ESP REFRESH=0 tsx --env-file=.env.local scripts/research-full.ts",
    "research:esp:refresh": "NATIONS=ESP tsx --env-file=.env.local scripts/research-full.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "@vercel/analytics": "^2.0.1",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "tsx": "^4.19.4",
    "typescript": "^5"
  }
}
